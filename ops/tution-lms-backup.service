[Unit]
Description=Encrypted Tution LMS PostgreSQL backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/tution-lms
ExecStart=/usr/local/sbin/tution-lms-backup
Environment=RCLONE_CONFIG=/etc/rclone/tution-lms.conf
UMask=0077
RuntimeDirectory=tution-lms-backup
RuntimeDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/run/tution-lms-backup /var/tmp /var/log
ProtectHome=true
