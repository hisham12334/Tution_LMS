# Copy to .env on the VPS. Keep the real file private and outside Git.
POSTGRES_DB=tution_lms
POSTGRES_USER=tution_lms
DOMAIN=REPLACE_WITH_YOUR_DOMAIN
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
DATABASE_URL=postgres://tution_lms:REPLACE_WITH_64_HEX_CHARACTERS@db:5432/tution_lms

NODE_ENV=production
PORT=3001
APP_ORIGIN=https://REPLACE_WITH_YOUR_DOMAIN
BETTER_AUTH_URL=https://REPLACE_WITH_YOUR_DOMAIN
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

SMTP_HOST=live.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_MAILTRAP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_MAILTRAP_PASSWORD
SMTP_FROM=Astute Academy <no-reply@REPLACE_WITH_VERIFIED_DOMAIN>

R2_ACCOUNT_ID=REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
R2_BUCKET=REPLACE_WITH_PRIVATE_BUCKET_NAME
