NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://postgres:postgres@localhost:5432/astute
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3001
APP_ORIGIN=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Astute Academy <no-reply@example.com>
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=astute-private

# One-time demo seed (run locally against staging/production DATABASE_URL):
# SEED_DEMO=true SEED_PASSWORD=your-demo-password npm run db:seed-demo
# Render external DATABASE_URL often needs ?sslmode=require when running from your PC.
# Optional: SEED_ADMIN_EMAIL, SEED_TEACHER_EMAIL, SEED_STUDENT_EMAIL
